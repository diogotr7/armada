From: Diogo Trindade <diogotr7@gmail.com>
Subject: [PATCH] soundwire: qcom: program the SSP period on SM8750

The master never programs the SSP period in MCP_FRAME_CTRL, so it sends
no stream synchronisation points. The SM8750 RX Class-H port has a 64-bit
sample interval, which does not divide the 50x16 frame, so the master and
the codec can start on different phases of its two-frame sample grid and
the headphone Class-H data is misread on about half of the stream starts.
Program a 4 kHz SSP period on bank switches on SM8750 masters, as the
vendor driver does.
---
 drivers/soundwire/qcom.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index f84f846..8e11688 100644
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -93,6 +93,8 @@
 #define SWRM_MCP_FRAME_CTRL_BANK_ADDR(m)		(0x101C + 0x40 * (m))
 #define SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK			GENMASK(2, 0)
 #define SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK			GENMASK(7, 3)
+#define SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_BMSK		GENMASK(23, 16)
+#define SWRM_SSP_RATE						4000
 #define SWRM_MCP_BUS_CTRL					0x1044
 #define SWRM_MCP_BUS_CLK_START					BIT(1)
 #define SWRM_MCP_CFG_ADDR					0x1048
@@ -1008,13 +1010,21 @@ static int qcom_swrm_pre_bank_switch(struct sdw_bus *bus)
 {
 	u32 reg = SWRM_MCP_FRAME_CTRL_BANK_ADDR(bus->params.next_bank);
 	struct qcom_swrm_ctrl *ctrl = to_qcom_sdw(bus);
-	u32 val;
+	u32 val, ssp;
 
 	ctrl->reg_read(ctrl, reg, &val);
 
 	u32p_replace_bits(&val, ctrl->cols_index, SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK);
 	u32p_replace_bits(&val, ctrl->rows_index, SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK);
 
+	if (of_device_is_compatible(ctrl->dev->of_node, "qcom,soundwire-v2.1.0")) {
+		ssp = bus->params.curr_dr_freq /
+		      (bus->params.row * bus->params.col * SWRM_SSP_RATE);
+		if (ssp)
+			u32p_replace_bits(&val, ssp - 1,
+					  SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_BMSK);
+	}
+
 	return ctrl->reg_write(ctrl, reg, val);
 }
 
