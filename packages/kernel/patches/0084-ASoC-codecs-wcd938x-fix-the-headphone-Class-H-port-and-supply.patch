From: Diogo Trindade <diogotr7@gmail.com>
Subject: [PATCH] ASoC: codecs: wcd938x: fix the headphone Class-H port and
 supply

The RX Class-H port is declared as a simple data port, so its DPN_HCtrl
keeps its reset value while the RX master sends the Class-H data in a
narrower column window, and the headphone output clips far below full
scale. Declare it as a full data port on the RX device only, as the TX
device shares the port table. That also requires the shared headphone
supply to be sequenced once: each HPH PA re-ran the forced-IQ startup
sequence and the first PA to stop tore the supply down under the other,
so only the first HPH PA to start and the last to stop now drive the
Class-H state.

---
 sound/soc/codecs/wcd938x-sdw.c | 10 +++++++++-
 sound/soc/codecs/wcd938x.c     | 26 ++++++++++++++++++--------
 2 files changed, 27 insertions(+), 9 deletions(-)

diff --git a/sound/soc/codecs/wcd938x-sdw.c b/sound/soc/codecs/wcd938x-sdw.c
index 5b2342a..4c71ff3 100644
--- a/sound/soc/codecs/wcd938x-sdw.c
+++ b/sound/soc/codecs/wcd938x-sdw.c
@@ -1196,8 +1196,16 @@ static int wcd9380_probe(struct sdw_slave *pdev,
 		wcd->ch_info = &wcd938x_sdw_tx_ch_info[0];
 		pdev->prop.wake_capable = true;
 	} else {
+		struct sdw_dpn_prop *rx_prop;
+
+		rx_prop = devm_kmemdup(dev, wcd938x_dpn_prop, sizeof(wcd938x_dpn_prop),
+				       GFP_KERNEL);
+		if (!rx_prop)
+			return -ENOMEM;
+		rx_prop[WCD938X_CLSH_PORT - 1].type = SDW_DPN_FULL;
+
 		pdev->prop.sink_ports = GENMASK(WCD938X_MAX_SWR_PORTS - 1, 0);
-		pdev->prop.sink_dpn_prop = wcd938x_dpn_prop;
+		pdev->prop.sink_dpn_prop = rx_prop;
 		wcd->ch_info = &wcd938x_sdw_rx_ch_info[0];
 	}
 
diff --git a/sound/soc/codecs/wcd938x.c b/sound/soc/codecs/wcd938x.c
index d728521..2f391ac 100644
--- a/sound/soc/codecs/wcd938x.c
+++ b/sound/soc/codecs/wcd938x.c
@@ -115,6 +115,8 @@ enum {
 	HPH_PA_DELAY,
 	AMIC2_BCS_ENABLE,
 	WCD_SUPPLIES_LPM_MODE,
+	HPHL_ACTIVE,
+	HPHR_ACTIVE,
 };
 
 enum {
@@ -695,8 +697,10 @@ static int wcd938x_codec_enable_hphr_pa(struct snd_soc_dapm_widget *w,
 		if (wcd938x->ldoh)
 			snd_soc_component_write_field(component, WCD938X_LDOH_MODE,
 						      WCD938X_LDOH_EN_MASK, 1);
-		wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_PRE_DAC,
-					WCD_CLSH_STATE_HPHR, hph_mode);
+		if (!test_bit(HPHL_ACTIVE, &wcd938x->status_mask))
+			wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_PRE_DAC,
+						WCD_CLSH_STATE_HPHR, hph_mode);
+		set_bit(HPHR_ACTIVE, &wcd938x->status_mask);
 		wcd_clsh_set_hph_mode(wcd938x->clsh_info, CLS_H_HIFI);
 
 		if (hph_mode == CLS_H_LP || hph_mode == CLS_H_LOHIFI ||
@@ -779,8 +783,10 @@ static int wcd938x_codec_enable_hphr_pa(struct snd_soc_dapm_widget *w,
 					      WCD938X_HPHR_REF_EN_MASK, 0);
 		snd_soc_component_write_field(component, WCD938X_DIGITAL_PDM_WD_CTL1,
 					      WCD938X_PDM_WD_EN_MASK, 0);
-		wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_POST_PA,
-					WCD_CLSH_STATE_HPHR, hph_mode);
+		clear_bit(HPHR_ACTIVE, &wcd938x->status_mask);
+		if (!test_bit(HPHL_ACTIVE, &wcd938x->status_mask))
+			wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_POST_PA,
+						WCD_CLSH_STATE_HPHR, hph_mode);
 		if (wcd938x->ldoh)
 			snd_soc_component_write_field(component, WCD938X_LDOH_MODE,
 						      WCD938X_LDOH_EN_MASK, 0);
@@ -802,8 +808,10 @@ static int wcd938x_codec_enable_hphl_pa(struct snd_soc_dapm_widget *w,
 		if (wcd938x->ldoh)
 			snd_soc_component_write_field(component, WCD938X_LDOH_MODE,
 						      WCD938X_LDOH_EN_MASK, 1);
-		wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_PRE_DAC,
-					WCD_CLSH_STATE_HPHL, hph_mode);
+		if (!test_bit(HPHR_ACTIVE, &wcd938x->status_mask))
+			wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_PRE_DAC,
+						WCD_CLSH_STATE_HPHL, hph_mode);
+		set_bit(HPHL_ACTIVE, &wcd938x->status_mask);
 		wcd_clsh_set_hph_mode(wcd938x->clsh_info, CLS_H_HIFI);
 		if (hph_mode == CLS_H_LP || hph_mode == CLS_H_LOHIFI ||
 		    hph_mode == CLS_H_ULP) {
@@ -884,8 +892,10 @@ static int wcd938x_codec_enable_hphl_pa(struct snd_soc_dapm_widget *w,
 					      WCD938X_HPHL_REF_EN_MASK, 0);
 		snd_soc_component_write_field(component, WCD938X_DIGITAL_PDM_WD_CTL0,
 					      WCD938X_PDM_WD_EN_MASK, 0);
-		wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_POST_PA,
-					WCD_CLSH_STATE_HPHL, hph_mode);
+		clear_bit(HPHL_ACTIVE, &wcd938x->status_mask);
+		if (!test_bit(HPHR_ACTIVE, &wcd938x->status_mask))
+			wcd_clsh_ctrl_set_state(wcd938x->clsh_info, WCD_CLSH_EVENT_POST_PA,
+						WCD_CLSH_STATE_HPHL, hph_mode);
 		if (wcd938x->ldoh)
 			snd_soc_component_write_field(component, WCD938X_LDOH_MODE,
 						      WCD938X_LDOH_EN_MASK, 0);
